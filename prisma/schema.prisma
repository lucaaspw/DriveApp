// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String
  name          String?
  dailyGoal     Float     @default(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  workDays      WorkDay[]
  fuelings      Fueling[]
}

model WorkDay {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @db.Date
  hoursWorked   Float
  kmDriven      Float
  tripsCount    Int?      // Número de viagens (opcional, inspirado no CPMA)
  uberEarnings  Float     @default(0)
  ninetynineEarnings Float @default(0)
  inDriveEarnings Float   @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
}

model Fueling {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @default(now())
  amount        Float
  kmDriven      Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}
