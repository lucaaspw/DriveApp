// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String
  name          String?
  dailyGoal     Float     @default(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  workDays      WorkDay[]
  fuelings      Fueling[]
  monthlyExpenses MonthlyExpense[]
  weeklyGoals   WeeklyGoal[]
}

model WorkDay {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @db.Date
  hoursWorked   Float
  kmDriven      Float
  tripsCount    Int?      // Número de viagens (opcional, inspirado no CPMA)
  uberEarnings  Float     @default(0)
  ninetynineEarnings Float @default(0)
  inDriveEarnings Float   @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
}

model Fueling {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @default(now())
  amount        Float
  kmDriven      Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}

model MonthlyExpense {
  id            String    @id @default(cuid())
  userId        String
  name          String
  amount        Float
  dueDate       DateTime  @db.Date
  category      String    // Parcela da casa, Água, Luz, Internet, Celular, Móveis, Cartão, etc.
  isPaid        Boolean   @default(false)
  paidDate      DateTime? @db.Date
  isRecurring   Boolean   @default(false)  // Se true, a despesa se repete todo mês
  dueDay        Int?      // Dia do mês (1-31) para despesas recorrentes
  recurringExpenseId String? // ID da despesa recorrente original (para agrupar)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, dueDate])
  @@index([userId, isPaid])
  @@index([userId, isRecurring])
  @@index([recurringExpenseId])
}

model WeeklyGoal {
  id            String    @id @default(cuid())
  userId        String
  monday        Float     @default(400)
  tuesday       Float     @default(470)
  wednesday     Float     @default(470)
  thursday      Float     @default(470)
  friday        Float     @default(550)
  saturday      Float     @default(390)
  sunday        Float     @default(0)
  weeklyTotal   Float     @default(2750)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@index([userId])
}
